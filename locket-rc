/**
 * locket-rc.js  v2.0
 * Locket — Firebase Remote Config response patch
 *
 * Mở khóa Gold, tắt quảng cáo, bật video 30s.
 *
 * Chiến lược forward-compatible (hoạt động lâu dài):
 *   1. Parse response của server, GIỮ NGUYÊN mọi key server gửi về.
 *   2. Merge (additive) — chỉ ADD/OVERRIDE các key cần thiết.
 *   3. Từng section wrap try-catch riêng → 1 section lỗi không ảnh hưởng section khác.
 *   4. Detect version app từ User-Agent để adapt nếu cần.
 *
 * Target : firebaseremoteconfig.googleapis.com/v1/projects/locket-4252a/*
 * Type   : http-response
 * Tested : Locket 3.x – 6.x
 *
 * GitHub : olcphm-ctrl/locket-scripts
 */

(function () {
    // ── Version detection ─────────────────────────────────────────────────
    var ua = $request.headers["User-Agent"] || $request.headers["user-agent"] || "";
    if (!ua.includes("Locket")) {
        $done({ body: $response.body });
        return;
    }

    var appVersion = [0, 0, 0];
    var verMatch   = ua.match(/Locket\/(\d+)\.(\d+)\.?(\d*)/);
    if (verMatch) {
        appVersion = [
            parseInt(verMatch[1], 10) || 0,
            parseInt(verMatch[2], 10) || 0,
            parseInt(verMatch[3], 10) || 0
        ];
    }

    // ── Parse response ────────────────────────────────────────────────────
    var obj;
    try {
        obj = JSON.parse($response.body);
    } catch (e) {
        $done({ body: $response.body });
        return;
    }

    obj.entries = obj.entries || {};

    // ── Helper: merge an object into entries (stringify sub-objects) ──────
    function mergeEntries(patch) {
        Object.keys(patch).forEach(function (k) {
            var v = patch[k];
            obj.entries[k] = (typeof v === "object" && v !== null) ? JSON.stringify(v) : String(v);
        });
    }

    // Helper: merge deep into a JSON-string entry
    function mergeJsonEntry(key, patch) {
        var base = {};
        try { base = JSON.parse(obj.entries[key] || "{}"); } catch (e) {}
        Object.assign(base, patch);
        obj.entries[key] = JSON.stringify(base);
    }

    // ── 1. Gold feature gates ─────────────────────────────────────────────
    try {
        var fgBase = {};
        try { fgBase = JSON.parse(obj.entries["feature_gates"] || "{}"); } catch (e) {}
        Object.assign(fgBase, {
            app_icon_picker:      "enabled",
            camera_roll:          "enabled",
            camera_theme:         "enabled",
            locket_views:         "enabled",
            long_captions:        "enabled",
            longer_video:         "enabled",
            unlimited_friends:    "enabled",
            priority_support:     "enabled",
            profile_badge:        "enabled",
            remove_ads:           "enabled",
            video:                "enabled",
            custom_widget_frames: "enabled",
            streak_recovery:      "enabled",
            // future-proof extras seen in newer builds
            locket_gold:          "enabled",
            gold_features:        "enabled",
            premium:              "enabled"
        });
        obj.entries["feature_gates"] = JSON.stringify(fgBase);
    } catch (e) {}

    // ── 2. Upsell / paywall — tắt hoàn toàn ──────────────────────────────
    try {
        mergeEntries({
            upsell_features: {
                app_icon_picker:      true,
                camera_roll:          true,
                camera_theme:         true,
                locket_views:         true,
                remove_ads:           true,
                custom_widget_frames: true
            },
            paywall_presentation_config: {
                uid:               "paywall_disabled",
                onboarding:        false,
                after_sent_moment: false,
                on_foreground:     false,
                interval:          2592000,
                profile_banner:    false
            },
            feature_discovery_popup_config: {
                tag:              "LOCKET GOLD",
                tag_gradient:     true,
                tag_style:        "gold_gradient",
                title:            "Đã kích hoạt 💛",
                feature_set:      [],
                primary_button_title: "OK",
                campaign:         "locket_gold_custom",
                start_at:         "2020-01-01T00:00:00",
                end_at:           "2099-12-31T23:59:59",
                use_local_time_zone: true
            },
            android_subscribe_gold_button_enabled: "false",
            profile_badge_visible:                 "true",
            lunar_new_year_app_icon_enabled:       "true"
        });
    } catch (e) {}

    // ── 3. Ads — tắt hoàn toàn ───────────────────────────────────────────
    try {
        mergeEntries({
            history_ads_mode:                           "off",
            history_ads_prefetch_count:                 "0",
            history_ads_prefetch_immediate:             "false",
            history_ads_prefetch_reroute:               "false",
            history_ads_dynamic_insertion:              "false",
            history_ads_refresh_prefetch_on_foreground: "false",
            history_ads_floor_price:                    "0",
            history_ads_floor_price_att:                "0",
            history_ad_log_displayed_on_background:     "false",
            history_ads_debug_menu:                     "false",
            ads_enabled:                                "false",
            show_ads:                                   "false",
            interstitial_ads_enabled:                   "false",
            banner_ads_enabled:                         "false"
        });
    } catch (e) {}

    // ── 4. Sentry / analytics — tắt tracking ─────────────────────────────
    try {
        mergeEntries({
            sentry_sample_rate:           "0",
            sentry_network_tracing:       "false",
            sentry_performance_tracking:  "false",
            sentry_trace_sample_rate:     "0",
            sentry_profiles_sample_rate:  "0"
        });
    } catch (e) {}

    // ── 5. Camera — 30s, full features ───────────────────────────────────
    try {
        mergeJsonEntry("camera", {
            gold_max_duration:  30.0,
            goldMaxDuration:    30.0,
            max_duration:       30.0,
            maxDuration:        30.0,
            ultra_wide:         true,
            ultraWide:          true,
            volume_button:      true,
            volumeButton:       true,
            flash_button:       true,
            telephoto:          true,
            srgb:               true,
            lanczos:            true,
            quality_mbps:       0.9,
            qualityMbps:        0.9
        });
    } catch (e) {}

    // ── 6. Camera roll — 30s ─────────────────────────────────────────────
    try {
        mergeJsonEntry("camera_roll", {
            gold_max_duration:        30.0,
            goldMaxDuration:          30.0,
            video_max_duration:       30.0,
            videoMaxDuration:         30.0,
            max_duration:             30.0,
            maxDuration:              30.0,
            trim_max_duration:        30.0,
            trimMaxDuration:          30.0,
            camera_roll_max_duration: 30.0,
            quality_mbps:             0.9,
            qualityMbps:              0.9,
            flash_button:             true
        });
    } catch (e) {}

    // ── 7. Flat duration keys — cover mọi naming convention ──────────────
    try {
        var durationKeys = [
            "camera_roll_video_max_duration",
            "camera_roll_max_duration",
            "camera_roll_duration",
            "max_video_duration",
            "video_max_duration",
            "video_trim_max_duration",
            "trim_max_duration",
            "gold_max_duration",
            "goldMaxDuration",
            "maxDuration",
            "max_duration"
        ];
        durationKeys.forEach(function (k) { obj.entries[k] = "30.0"; });

        mergeEntries({
            camera_roll_preview_enabled:               "true",
            camera_roll_video_enabled:                 "true",
            camera_roll_video_upload_enabled:          "true",
            internal_camera_roll_video_upload_enabled: "true",
            longer_camera_roll_videos_enabled:         "true",
            video_quality_mbps:                        "0.9",
            video_sound_enabled:                       "true",
            microphone_enabled:                        "true",
            camera_microphone_enabled:                 "true",
            audio_session_deactivation_enabled:        "true",
            zoom_enabled:                              "true",
            upload_main:                               "false",
